#!/bin/bash
# AppRun for MESA Easy Manager AppImage
set -euo pipefail

HERE="$(dirname "$(readlink -f "${0}")")"
export MESA_EASY_MANAGER_ROOT="${HERE}/usr/share/mesa-easy-manager"
export PYTHONPATH="${MESA_EASY_MANAGER_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"

# Prefer system Python so PyGObject matches the host GTK stack.
if command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="$(command -v python3)"
else
  echo "MESA Easy Manager requires python3 on the host." >&2
  exit 1
fi

if ! "${PYTHON_BIN}" -c "import gi; gi.require_version('Gtk', '3.0'); from gi.repository import Gtk" >/dev/null 2>&1; then
  echo "MESA Easy Manager requires host packages: python3-gi gir1.2-gtk-3.0" >&2
  echo "On Debian/Armbian: sudo apt install python3-gi gir1.2-gtk-3.0 policykit-1" >&2
  exit 1
fi

exec "${PYTHON_BIN}" -m mesa_easy_manager "$@"
