[Unit]
Description=Auto-install AYN Thor touch fix (once)
Documentation=file:///usr/share/odin3/fix-thor-screen/README.txt
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
After=armbian-resize-filesystem.service
Before=display-manager.service multi-user.target
ConditionPathExists=!/var/lib/odin3/thor-autoinstall.done

[Service]
Type=oneshot
ExecStart=/usr/lib/odin3/thor-autoinstall.sh
RemainAfterExit=yes
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
