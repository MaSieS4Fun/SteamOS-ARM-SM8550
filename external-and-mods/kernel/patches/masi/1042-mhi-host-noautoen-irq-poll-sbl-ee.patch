From: MaSi-OS <masies@local>
Subject: [PATCH] bus: mhi: host: NO_AUTOEN MSI + poll SBL EE

On SM8550 7.2.8, disable_irq()+enable_irq() on qcom-pcie MSI leaves
WCN7850 vectors masked. BHI firmware can complete via MMIO poll, but
the EE SBL event (event ring + MSI) never arrives, so AMSS is never
downloaded and no wlan appears.

Request IRQs with IRQF_NO_AUTOEN instead of disable_irq() after
request_irq(). Poll BHI EXECENV after READY and queue the SBL
transition if MSI still misses it.

Signed-off-by: MaSi-OS <masies@local>

diff -u -N -r a/drivers/bus/mhi/host/init.c b/drivers/bus/mhi/host/init.c
--- a/drivers/bus/mhi/host/init.c
+++ b/drivers/bus/mhi/host/init.c
@@ -193,7 +193,7 @@
 static int mhi_init_irq_setup(struct mhi_controller *mhi_cntrl)
 {
 	struct mhi_event *mhi_event = mhi_cntrl->mhi_event;
-	unsigned long irq_flags = IRQF_SHARED | IRQF_NO_SUSPEND;
+	unsigned long irq_flags = IRQF_SHARED | IRQF_NO_SUSPEND | IRQF_NO_AUTOEN;
 	int i, ret;
 
 	/* if controller driver has set irq_flags, use it */
@@ -207,13 +207,17 @@
 				   irq_flags,
 				   "bhi", mhi_cntrl);
 	if (ret)
 		return ret;
-	/*
-	 * IRQs should be enabled during mhi_async_power_up(), so disable them explicitly here.
-	 * Due to the use of IRQF_SHARED flag as default while requesting IRQs, we assume that
-	 * IRQ_NOAUTOEN is not applicable.
-	 */
-	disable_irq(mhi_cntrl->irq[0]);
+
+	/*
+	 * Do not disable_irq() after request. On SM8550 qcom-pcie MSI,
+	 * disable_irq()+enable_irq() leaves the WCN7850 vectors masked.
+	 * IRQF_NO_AUTOEN keeps them off until mhi_async_power_up().
+	 */
+	if (!(irq_flags & IRQF_NO_AUTOEN))
+		disable_irq(mhi_cntrl->irq[0]);
 
 	for (i = 0; i < mhi_cntrl->total_ev_rings; i++, mhi_event++) {
 		if (mhi_event->offload_ev)
 			continue;
@@ -235,7 +239,8 @@
 			goto error_request;
 		}
 
-		disable_irq(mhi_cntrl->irq[mhi_event->irq]);
+		if (!(irq_flags & IRQF_NO_AUTOEN))
+			disable_irq(mhi_cntrl->irq[mhi_event->irq]);
 	}
 
 	return 0;
diff -u -N -r a/drivers/bus/mhi/host/boot.c b/drivers/bus/mhi/host/boot.c
--- a/drivers/bus/mhi/host/boot.c
+++ b/drivers/bus/mhi/host/boot.c
@@ -631,7 +631,38 @@
 	}
 
 	dev_info(dev, "Wait for device to enter SBL or Mission mode\n");
+	{
+		unsigned long timeout = jiffies + msecs_to_jiffies(3000);
+		enum mhi_ee_type ee;
+
+		do {
+			ee = mhi_get_exec_env(mhi_cntrl);
+			if (ee == MHI_EE_SBL) {
+				dev_info(dev, "Polled EE SBL, queueing AMSS download\n");
+				mhi_queue_state_transition(mhi_cntrl,
+							   DEV_ST_TRANSITION_SBL);
+				break;
+			}
+			if (MHI_IN_MISSION_MODE(ee)) {
+				dev_info(dev, "Polled EE %s\n",
+					 TO_MHI_EXEC_STR(ee));
+				mhi_queue_state_transition(mhi_cntrl,
+							   DEV_ST_TRANSITION_MISSION_MODE);
+				break;
+			}
+			usleep_range(2000, 4000);
+		} while (time_before(jiffies, timeout));
+
+		if (ee != MHI_EE_SBL && !MHI_IN_MISSION_MODE(ee))
+			dev_info(dev, "EE still %s after poll (waiting for MSI)\n",
+				 TO_MHI_EXEC_STR(ee));
+	}
 	return;
 
 error_ready_state:
 	if (mhi_cntrl->fbc_image) {
diff -u -N -r a/drivers/net/wireless/ath/ath12k/mhi.c b/drivers/net/wireless/ath/ath12k/mhi.c
--- a/drivers/net/wireless/ath/ath12k/mhi.c
+++ b/drivers/net/wireless/ath/ath12k/mhi.c
@@ -5,6 +5,7 @@
  */
 
+#include <linux/interrupt.h>
 #include <linux/msi.h>
 #include <linux/pci.h>
 #include <linux/firmware.h>
@@ -255,8 +256,11 @@
 		ath12k_err(ab, "failed to get msi for mhi\n");
 		goto free_controller;
 	}
 
-	if (!test_bit(ATH12K_PCI_FLAG_MULTI_MSI_VECTORS, &ab_pci->flags))
-		mhi_ctrl->irq_flags = IRQF_SHARED | IRQF_NOBALANCING;
+	if (!test_bit(ATH12K_PCI_FLAG_MULTI_MSI_VECTORS, &ab_pci->flags))
+		mhi_ctrl->irq_flags = IRQF_SHARED | IRQF_NOBALANCING |
+				      IRQF_NO_SUSPEND | IRQF_NO_AUTOEN;
+	else
+		mhi_ctrl->irq_flags = IRQF_NO_SUSPEND | IRQF_NO_AUTOEN;
 
 	mhi_ctrl->iova_start = 0;
 	mhi_ctrl->iova_stop = ab_pci->dma_mask;
