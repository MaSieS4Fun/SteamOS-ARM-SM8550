From: MaSi-OS <masies@local>
Subject: [PATCH] scsi: ufs: core: silence unsupported qTimestamp on SM8550 UFS

Mark UFS_DEVICE_QUIRK_NO_TIMESTAMP_SUPPORT after the first qTimestamp -EINVAL
and downgrade further messages to dev_dbg.
Signed-off-by: MaSi-OS <masies@local>

diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -3681,6 +3681,14 @@ int ufshcd_query_attr_qword(struct ufs_hba *hba, enum query_opcode opcode,
 
 	err = ufshcd_exec_dev_cmd(hba, DEV_CMD_TYPE_QUERY, dev_cmd_timeout);
 	if (err) {
+		if (idn == QUERY_ATTR_IDN_TIMESTAMP && err == -EINVAL) {
+			hba->dev_quirks |= UFS_DEVICE_QUIRK_NO_TIMESTAMP_SUPPORT;
+			dev_dbg(hba->dev,
+				"%s: timestamp attr not supported (opcode 0x%.2x, err %d)\n",
+				__func__, opcode, err);
+			goto out_unlock;
+		}
 		dev_err(hba->dev, "%s: opcode 0x%.2x for idn %d failed, index %d, selector %d, err = %d\n",
 			__func__, opcode, idn, index, sel, err);
 		goto out_unlock;
@@ -9367,9 +9375,18 @@ static void ufshcd_set_timestamp_attr(struct ufs_hba *hba)
 	ts_ns = ktime_get_real_ns();
 	err = ufshcd_query_attr_qword(hba, UPIU_QUERY_OPCODE_WRITE_ATTR,
 				      QUERY_ATTR_IDN_TIMESTAMP, 0, 0, &ts_ns);
-	if (err)
-		dev_err(hba->dev, "%s: failed to set timestamp %d\n",
-			__func__, err);
+	if (err) {
+		if (err == -EINVAL) {
+			hba->dev_quirks |= UFS_DEVICE_QUIRK_NO_TIMESTAMP_SUPPORT;
+			dev_dbg(hba->dev, "%s: timestamp not supported (%d)\n",
+				__func__, err);
+		} else {
+			dev_err(hba->dev, "%s: failed to set timestamp %d\n",
+				__func__, err);
+		}
+	}
 }
