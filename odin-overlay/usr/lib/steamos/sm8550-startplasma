#!/bin/bash
# Official startplasma-wayland, after clearing Game Mode Qt/X11 leftovers.
/usr/bin/steamosctl clean-temporary-sessions >/dev/null 2>&1 || true
OVERRIDE=/etc/sddm.conf.d/zzz-sm8550-session-override.conf
if [[ -w "$OVERRIDE" ]]; then
  cat >"$OVERRIDE" <<'EOF'
[Autologin]
Relogin=true
Session=gamescope-wayland.desktop
User=steamos
EOF
fi
/usr/lib/steamos/sm8550-prepare-plasma
exec /usr/bin/startplasma-wayland "$@"
