#!/usr/bin/env bash
# Game Mode keeps scanout on the internal panel. gamescope drops DP/HDMI
# without an EDID probe while GAMESCOPE_FORCE_INTERNAL=1. An X11 output
# query here would probe the dock and can freeze the panel the same way.
# Desktop dock layout is handled by sm8550-plasma-display.
echo "sm8550-dock-hotplug: external connectors stay with gamescope" | logger -t sm8550-dock || true
exit 0
