#!/usr/bin/env bash
# Watch DP/HDMI connect/disconnect during Game Mode.
# gamescope stays on DSI (--force-internal); this only keeps Steam config stable
# and logs hotplug events. Does not restart Steam or gamescope.
set +e

log() { echo "sm8550-dock-hotplug: $*" | logger -t sm8550-dock; }

last=unknown
while sleep 2; do
  cur=off
  for f in /sys/class/drm/card*-DP-*/status /sys/class/drm/card*-HDMI-A-*/status; do
    [[ -r "$f" ]] || continue
    [[ "$(tr -d '[:space:]' <"$f")" == connected ]] && cur=on && break
  done
  [[ "$cur" == "$last" ]] && continue
  log "dock ${last} -> ${cur}"
  last="$cur"
  if [[ -x /usr/lib/steamos/sm8550-fix-steam-display ]]; then
    /usr/lib/steamos/sm8550-fix-steam-display 2>&1 | logger -t sm8550-dock || true
  fi
  if [[ -x /usr/lib/steamos/sm8550-disable-external-x11 && "${SM8550_DOCK_DISPLAY:-0}" != "1" ]]; then
    DISPLAY="${DISPLAY:-:0}" /usr/lib/steamos/sm8550-disable-external-x11 2>&1 | logger -t sm8550-dock || true
  fi
done
