#!/bin/bash
# Grow the home partition (p3 / LABEL=home) to fill the SD/UFS, then resize ext4.
# Runs *before* home.mount so growpart is not fighting a mounted filesystem.
# TMPDIR is /run: growpart's mktemp under /tmp races with tmp.mount and then
# hangs systemd for TimeoutStartSec (90s every boot, no stamp).
# Do not stamp on a real failure — retry next boot. DO stamp if already max.
set -u

STAMP_DIR=/var/lib/steamos-sm8550
STAMP="${STAMP_DIR}/home-expanded"
LOG=/var/log/steamos-sm8550-expand-home.log
TMPDIR="${TMPDIR:-/run/steamos-sm8550-expand-home}"
mkdir -p "$STAMP_DIR" /var/log "$TMPDIR"
export TMPDIR

exec >>"$LOG" 2>&1

ts() { date -Iseconds; }
log() { printf '%s %s\n' "$(ts)" "$*"; }

stamp_ok() {
  mkdir -p "$STAMP_DIR"
  touch "$STAMP"
  log "wrote ${STAMP}"
}

log "=== expand-home start ==="

if [[ -f "$STAMP" ]]; then
  log "marker ${STAMP} present — skip"
  exit 0
fi

if ! command -v resize2fs >/dev/null 2>&1; then
  log "ERROR: resize2fs missing — skip (will retry)"
  exit 0
fi

resolve_home() {
  local src disk uuid cand
  src="$(findmnt -no SOURCE /home 2>/dev/null || true)"
  if [[ -n "$src" && -e "$src" ]]; then
    src="$(readlink -f "$src")"
  fi
  disk="$(findmnt -no SOURCE / 2>/dev/null || true)"
  if [[ -n "$src" && -b "$src" && "$src" != "$disk" ]]; then
    printf '%s\n' "$src"
    return 0
  fi
  for cand in \
      /dev/disk/by-label/home \
      /dev/disk/by-partlabel/HOME \
      /dev/disk/by-partlabel/home; do
    if [[ -b "$cand" ]]; then
      readlink -f "$cand"
      return 0
    fi
  done
  uuid="$(awk '$2 == "/home" && $1 ~ /^UUID=/ {
    u = $1; sub(/^UUID=/, "", u); print u; exit
  }' /etc/fstab 2>/dev/null || true)"
  if [[ -n "${uuid}" && -b "/dev/disk/by-uuid/${uuid}" ]]; then
    readlink -f "/dev/disk/by-uuid/${uuid}"
    return 0
  fi
  return 1
}

HOME_SRC="$(resolve_home || true)"
if [[ -z "${HOME_SRC}" || ! -b "${HOME_SRC}" ]]; then
  log "home partition not found yet (LABEL=home / UUID / dedicated /home) — retry next boot"
  exit 0
fi

case "${HOME_SRC}" in
  /dev/mapper/*|/dev/dm-*|/dev/loop*)
    log "home is mapper/loop (${HOME_SRC}) — skip"
    stamp_ok
    log "=== expand-home done ==="
    exit 0
    ;;
esac

FSTYPE="$(blkid -o value -s TYPE "${HOME_SRC}" 2>/dev/null || true)"
if [[ "${FSTYPE}" != ext4 && "${FSTYPE}" != ext3 && "${FSTYPE}" != ext2 ]]; then
  log "home fstype=${FSTYPE:-unknown} — only ext* supported, skip"
  stamp_ok
  log "=== expand-home done ==="
  exit 0
fi

PART_BASE="$(basename "${HOME_SRC}")"
PART_SYS="/sys/class/block/${PART_BASE}/partition"
if [[ ! -f "${PART_SYS}" ]]; then
  log "ERROR: ${HOME_SRC} is not a partition node — retry next boot"
  exit 0
fi
PART_NUM="$(cat "${PART_SYS}")"

DISK_NAME="$(lsblk -no PKNAME "${HOME_SRC}" 2>/dev/null | head -1 || true)"
if [[ -z "${DISK_NAME}" ]]; then
  DISK_NAME="${PART_BASE%p${PART_NUM}}"
  DISK_NAME="${DISK_NAME%${PART_NUM}}"
fi
DISK="/dev/${DISK_NAME}"
if [[ ! -b "${DISK}" ]]; then
  log "ERROR: parent disk ${DISK} not a block device — retry next boot"
  exit 0
fi

MOUNTED=0
if findmnt -no SOURCE "${HOME_SRC}" >/dev/null 2>&1 || findmnt -no TARGET /home >/dev/null 2>&1; then
  if [[ "$(findmnt -no SOURCE /home 2>/dev/null || true)" == "${HOME_SRC}" ]]; then
    MOUNTED=1
  fi
fi

PART_START="$(cat "/sys/class/block/${PART_BASE}/start" 2>/dev/null || echo 0)"
PART_SIZE="$(cat "/sys/class/block/${PART_BASE}/size" 2>/dev/null || echo 0)"
DISK_SIZE="$(blockdev --getsz "${DISK}" 2>/dev/null || echo 0)"
PART_END=$((PART_START + PART_SIZE))
GAP=$((DISK_SIZE - PART_END))
ALREADY_MAX=0
# GPT backup is ~33 sectors; allow 1 MiB slack so we do not call growpart.
if [[ "${DISK_SIZE}" -gt 0 && "${GAP}" -le 2048 ]]; then
  ALREADY_MAX=1
fi

log "home SOURCE=${HOME_SRC} disk=${DISK} part=${PART_NUM} mounted=${MOUNTED} gap=${GAP} already_max=${ALREADY_MAX}"

if [[ "${ALREADY_MAX}" -eq 1 ]]; then
  log "partition already at max — skip growpart"
elif command -v growpart >/dev/null 2>&1; then
  log "growpart ${DISK} ${PART_NUM}"
  set +e
  GROW_OUT="$(timeout -k 2 12 growpart "${DISK}" "${PART_NUM}" 2>&1)"
  GROW_RC=$?
  set -e
  printf '%s\n' "${GROW_OUT}"
  if [[ "${GROW_RC}" -eq 0 ]]; then
    log "partition grew"
  elif [[ "${GROW_RC}" -eq 124 || "${GROW_RC}" -eq 137 ]]; then
    log "WARN: growpart timed out rc=${GROW_RC}"
  elif [[ "${GROW_RC}" -eq 1 ]] || printf '%s\n' "${GROW_OUT}" | grep -qi 'NOCHANGE'; then
    log "partition already at max (or NOCHANGE)"
    ALREADY_MAX=1
  else
    log "WARN: growpart rc=${GROW_RC} — still attempting resize2fs"
  fi
else
  log "growpart missing — sfdisk fallback"
  timeout -k 2 8 sh -c "echo ', +' | sfdisk --no-reread -N '${PART_NUM}' '${DISK}'" || true
fi

udevadm settle --timeout=5 2>/dev/null || true
timeout -k 1 5 partx -u "${DISK}" 2>/dev/null || true

if [[ "${MOUNTED}" -eq 0 ]]; then
  log "e2fsck -f -p ${HOME_SRC}"
  set +e
  timeout -k 2 15 e2fsck -f -p "${HOME_SRC}"
  FSCK_RC=$?
  set -e
  log "e2fsck rc=${FSCK_RC}"
fi

log "resize2fs ${HOME_SRC}"
set +e
RESIZE_OUT="$(timeout -k 2 20 resize2fs "${HOME_SRC}" 2>&1)"
RESIZE_RC=$?
set -e
printf '%s\n' "${RESIZE_OUT}"
if [[ "${RESIZE_RC}" -eq 0 ]] \
    || printf '%s\n' "${RESIZE_OUT}" | grep -qiE 'Nothing to do|already|is already'; then
  stamp_ok
  log "=== expand-home done ==="
  exit 0
fi

if [[ "${ALREADY_MAX}" -eq 1 ]]; then
  log "WARN: resize2fs rc=${RESIZE_RC} but partition already at max — stamp to unblock boot"
  stamp_ok
  log "=== expand-home done ==="
  exit 0
fi

log "WARN: resize2fs rc=${RESIZE_RC} — will retry next boot"
log "=== expand-home incomplete ==="
exit 0
