#!/bin/bash
# Bring up AYN-Odin2 playback clocks. Without UCM/I2S the aw88166 amps
# stay silent even when PipeWire has a sink and volume keys work.
set +e
export PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:$PATH}"

log() { echo "sm8550-audio-setup: $*" >&2; }

# ostree / image pack often leaves this 700 steam:steam.
if [[ -d /usr/share/alsa/ucm2/AYN ]]; then
  find /usr/share/alsa/ucm2/AYN /usr/share/alsa/ucm2/conf.d/sm8550 \
    /usr/share/alsa/ucm2/codecs /usr/share/alsa/ucm2/lib \
    -type d -exec chmod 0755 {} + 2>/dev/null
  find /usr/share/alsa/ucm2/AYN /usr/share/alsa/ucm2/conf.d/sm8550 \
    /usr/share/alsa/ucm2/codecs /usr/share/alsa/ucm2/lib \
    -type f -exec chmod 0644 {} + 2>/dev/null
fi

wait_card() {
  local i
  for i in $(seq 1 80); do
    if grep -qiE 'AYN|Odin2|sm8550' /proc/asound/cards 2>/dev/null; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

if ! wait_card; then
  log "no ASoC card yet"
  cat /proc/asound/cards >&2 || true
  exit 0
fi

card_id="$(awk 'BEGIN{IGNORECASE=1} /AYN|Odin2/{print $1; exit}' /proc/asound/cards)"
card_id="${card_id:-0}"
log "card ${card_id}: $(tr '\n' ' ' </proc/asound/cards 2>/dev/null)"

if command -v alsaucm >/dev/null 2>&1; then
  if alsaucm -c AYN-Odin2 set _verb HiFi set _enadev Speaker >/tmp/sm8550-alsaucm.log 2>&1; then
    log "alsaucm AYN-Odin2 HiFi Speaker ok"
  elif alsaucm -c "hw:${card_id}" set _verb HiFi set _enadev Speaker >>/tmp/sm8550-alsaucm.log 2>&1; then
    log "alsaucm hw:${card_id} HiFi Speaker ok"
  else
    log "alsaucm failed (mixers still applied)"
    cat /tmp/sm8550-alsaucm.log >&2 || true
  fi
fi

amixer -c "$card_id" cset name='PRIMARY_MI2S_RX Audio Mixer MultiMedia1' 1 >/dev/null 2>&1
amixer -c "$card_id" cset name='RX_CODEC_DMA_RX_0 Audio Mixer MultiMedia2' 1 >/dev/null 2>&1
amixer -c "$card_id" cset name='DISPLAY_PORT_RX_0 Audio Mixer MultiMedia2' 0 >/dev/null 2>&1
amixer -c "$card_id" cset name='RX_RX0 Digital Volume' 84 >/dev/null 2>&1
amixer -c "$card_id" cset name='RX_RX1 Digital Volume' 84 >/dev/null 2>&1

log "card ${card_id} speaker mixers applied"
exit 0
