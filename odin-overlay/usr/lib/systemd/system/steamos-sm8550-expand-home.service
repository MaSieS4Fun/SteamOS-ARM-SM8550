[Unit]
Description=Grow SteamOS home partition to fill the disk
DefaultDependencies=no
Conflicts=shutdown.target
After=systemd-udevd.service systemd-remount-fs.service
After=dev-disk-by-label-home.device
Before=home.mount local-fs.target
ConditionPathExists=!/var/lib/steamos-sm8550/home-expanded

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=TMPDIR=/run/steamos-sm8550-expand-home
RuntimeDirectory=steamos-sm8550-expand-home
RuntimeDirectoryMode=0700
ExecStart=/usr/lib/steamos/steamos-sm8550-expand-home
TimeoutStartSec=20
SuccessExitStatus=0

[Install]
WantedBy=local-fs-pre.target
