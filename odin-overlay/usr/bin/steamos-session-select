#!/bin/bash
# Official steamosctl wrapper. Prepare Wayland env before desktop mode so
# Plasma does not inherit Game Mode QT_QPA_PLATFORM=xcb.
set -e

session="${1:-gamescope}"

case "$session" in
  plasma-persistent)
    /usr/lib/steamos/sm8550-prepare-plasma
    steamosctl set-default-login-mode desktop
    steamosctl set-default-desktop-session plasma.desktop
    steamosctl switch-to-desktop-mode
    ;;
  plasma)
    /usr/lib/steamos/sm8550-prepare-plasma
    steamosctl set-default-desktop-session plasma.desktop
    steamosctl switch-to-desktop-mode
    ;;
  gamescope)
    # Pin speakers and stop connector poll before Plasma releases the dock.
    # Otherwise the unplug races a DisplayPort profile and a DRM detect(),
    # Game Mode comes up silent, and reboot can sit on a lit panel.
    mkdir -p "${HOME:-/home/steamos}/.local/state"
    touch "${HOME:-/home/steamos}/.local/state/sm8550-force-speaker"
    /usr/lib/steamos/sm8550-drm-poll off >/dev/null 2>&1 || true
    steamosctl set-default-login-mode game
    steamosctl switch-to-game-mode
    ;;
  *)
    echo >&2 "!! Unrecognized session '$session'"
    exit 1
    ;;
esac
