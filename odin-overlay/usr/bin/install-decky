#!/usr/bin/env bash
# Install Decky PluginLoader on SteamOS Frame (aarch64).
# PluginLoader is x86_64 — systemd must start it via Box64/FEX, not raw binfmt.
# Steam Client channel (not SteamOS) selects Decky's update branch:
#   Steam Client stable → loader.json branch 0
#   Steam Client beta   → loader.json branch 1
# The binary installed is always the newest GitHub PluginLoader (do not downgrade).
#
# Usage:
#   install-decky                 # ask Steam Client channel, then install
#   install-decky install
#   install-decky install-stable
#   install-decky install-beta
#   install-decky verify
#   install-decky uninstall
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"

log()  { printf '==> [decky] %s\n' "$*" >&2; }
warn() { printf '==> [decky] WARNING: %s\n' "$*" >&2; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

if [[ -d /home/steamos ]]; then
  REAL_USER="${SUDO_USER:-steamos}"
else
  REAL_USER="${SUDO_USER:-steam}"
fi
[[ "$REAL_USER" == "root" ]] && REAL_USER=steamos
if [[ -n "${PKEXEC_UID:-}" ]]; then
  _pkuser="$(getent passwd "$PKEXEC_UID" 2>/dev/null | cut -d: -f1 || true)"
  [[ -n "$_pkuser" && "$_pkuser" != root ]] && REAL_USER="$_pkuser"
fi
REAL_HOME="$(getent passwd "$REAL_USER" 2>/dev/null | cut -d: -f6 || true)"
REAL_HOME="${REAL_HOME:-/home/${REAL_USER}}"
REAL_UID="$(id -u "$REAL_USER" 2>/dev/null || echo 1000)"
REAL_GID="$(id -g "$REAL_USER" 2>/dev/null || echo 1000)"

HOMEBREW_ROOT="${REAL_HOME}/homebrew"
PLUGIN_LOADER="${HOMEBREW_ROOT}/services/PluginLoader"
LOADER_VERSION_FILE="${HOMEBREW_ROOT}/services/.loader.version"
LOADER_SETTINGS="${HOMEBREW_ROOT}/settings/loader.json"
PLUGIN_UNIT_USR="/usr/lib/systemd/system/plugin_loader.service"
PLUGIN_UNIT_ETC="/etc/systemd/system/plugin_loader.service"
SYSTEM_DROPINS="/usr/share/steamos-odin/plugin_loader.service.d"
BUNDLE_ROOT="/usr/share/steamos-odin/decky-plugins"
DECKY_LOADER_REPO="SteamDeckHomebrew/decky-loader"
DECKY_BRANCH="${DECKY_BRANCH:-}"
OVERLAY_ETC="/var/lib/overlays/etc/upper"

systemctl_root() {
  env -u DBUS_SESSION_BUS_ADDRESS systemctl --no-ask-password "$@"
}

box64_detected() {
  command -v box64 >/dev/null 2>&1 && return 0
  [[ -f /etc/binfmt.d/box64.conf || -f /usr/lib/binfmt.d/box64.conf ]] && return 0
  [[ -x /usr/local/bin/box64 || -x /usr/bin/box64 ]] && return 0
  return 1
}

fex_detected() {
  command -v FEX >/dev/null 2>&1 && return 0
  [[ -f /usr/lib/binfmt.d/FEX-x86_64.conf ]] && return 0
  return 1
}

require_emulator() {
  if box64_detected; then
    log "Box64 detected"
    return 0
  fi
  if fex_detected; then
    warn "Only FEXEmu detected — Box64 is recommended"
    return 0
  fi
  die "Decky needs Box64 or FEXEmu to run the x86_64 PluginLoader"
}

emulator_bin() {
  if [[ -x /usr/bin/box64 ]]; then
    printf '%s' /usr/bin/box64
    return 0
  fi
  if [[ -x /usr/local/bin/box64 ]]; then
    printf '%s' /usr/local/bin/box64
    return 0
  fi
  if command -v FEX >/dev/null 2>&1; then
    command -v FEX
    return 0
  fi
  return 1
}

normalize_branch() {
  case "${1,,}" in
    beta|prerelease|pre|install-beta) printf '%s' "prerelease" ;;
    *) printf '%s' "release" ;;
  esac
}

branch_label() {
  case "$(normalize_branch "${1:-release}")" in
    prerelease) printf '%s' "beta (Steam Client beta)" ;;
    *) printf '%s' "stable (Steam Client stable)" ;;
  esac
}

detect_steam_client_channel() {
  local f
  for f in \
    "${REAL_HOME}/.local/share/Steam/package/beta" \
    "${REAL_HOME}/.steam/steam/package/beta" \
    "${REAL_HOME}/.steam/root/package/beta"
  do
    if [[ -f "$f" ]]; then
      printf '%s' "prerelease"
      return 0
    fi
  done
  printf '%s' "release"
}

ask_steam_client_channel() {
  [[ -n "$DECKY_BRANCH" ]] && return 0
  local detected default choice
  detected="$(detect_steam_client_channel)"
  if [[ "$detected" == "prerelease" ]]; then
    default=2
    log "Detected Steam Client beta (package/beta present)"
  else
    default=1
    log "Detected Steam Client stable (no package/beta)"
  fi
  echo
  echo "Decky must match the Steam CLIENT channel, not SteamOS."
  echo "SteamOS can stay on Stable while the Steam client is on Beta."
  echo
  echo "  1) Steam Client stable  →  Decky update channel release"
  echo "  2) Steam Client beta    →  Decky update channel prerelease"
  echo
  if [[ -t 0 ]]; then
    read -r -p "Choose [${default}]: " choice || choice=""
  else
    choice=""
    warn "No TTY — using detected Steam Client channel"
  fi
  choice="${choice:-$default}"
  case "${choice}" in
    2|beta|prerelease|pre|b) DECKY_BRANCH="prerelease" ;;
    *) DECKY_BRANCH="release" ;;
  esac
  log "Selected: $(branch_label "$DECKY_BRANCH")"
}

elevate_if_needed() {
  [[ "${EUID}" -eq 0 ]] && return 0
  exec pkexec --disable-internal-agent "$SCRIPT_PATH" "$@"
}

# Newest PluginLoader asset (GitHub lists newest first). Channel only sets loader.json.
fetch_newest_loader() {
  local json version url
  json="$(curl -fsSL "https://api.github.com/repos/${DECKY_LOADER_REPO}/releases")" \
    || die "Failed to fetch decky-loader releases"
  version="$(printf '%s' "$json" | python3 -c 'import json,sys
rels=json.load(sys.stdin)
for r in rels:
    if any(a.get("name")=="PluginLoader" for a in r.get("assets") or []):
        print(r["tag_name"]); break
')"
  url="$(printf '%s' "$json" | python3 -c 'import json,sys
rels=json.load(sys.stdin)
for r in rels:
    for a in r.get("assets") or []:
        if a.get("name")=="PluginLoader":
            print(a["browser_download_url"]); raise SystemExit
')"
  [[ -n "$version" && -n "$url" ]] || die "No PluginLoader asset on GitHub"
  printf '%s\n%s\n' "$version" "$url"
}

write_plugin_loader_unit() {
  local dest="$1" emu start
  emu="$(emulator_bin || true)"
  if [[ -n "$emu" ]]; then
    start="${emu} ${PLUGIN_LOADER}"
  else
    start="${PLUGIN_LOADER}"
  fi
  mkdir -p "$(dirname "$dest")"
  cat >"$dest" <<EOF
[Unit]
Description=SteamDeck Plugin Loader
After=network-online.target systemd-binfmt.service local-fs.target home.mount
Wants=systemd-binfmt.service

[Service]
Type=simple
User=root
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=8
ExecStart=${start}
WorkingDirectory=${HOMEBREW_ROOT}/services
Environment=UNPRIVILEGED_PATH=${HOMEBREW_ROOT}
Environment=PRIVILEGED_PATH=${HOMEBREW_ROOT}
Environment=LOG_LEVEL=INFO
Environment=HOME=${REAL_HOME}
Environment=USER=${REAL_USER}
Environment=XDG_CONFIG_HOME=${REAL_HOME}/.config
Environment=XDG_DATA_HOME=${REAL_HOME}/.local/share
Environment=XDG_RUNTIME_DIR=/run/user/${REAL_UID}
Environment=BOX64_NOBANNER=1

[Install]
WantedBy=multi-user.target
EOF
  chmod 0644 "$dest"
}

persist_unit() {
  write_plugin_loader_unit "$PLUGIN_UNIT_USR"
  write_plugin_loader_unit "$PLUGIN_UNIT_ETC"
  mkdir -p /etc/systemd/system/multi-user.target.wants
  ln -sfn "$PLUGIN_UNIT_USR" /etc/systemd/system/multi-user.target.wants/plugin_loader.service
  if [[ -d "$OVERLAY_ETC" ]]; then
    mkdir -p "$OVERLAY_ETC/systemd/system/multi-user.target.wants" \
      "$OVERLAY_ETC/systemd/system/plugin_loader.service.d" || true
    write_plugin_loader_unit "$OVERLAY_ETC/systemd/system/plugin_loader.service" || true
    ln -sfn "$PLUGIN_UNIT_USR" \
      "$OVERLAY_ETC/systemd/system/multi-user.target.wants/plugin_loader.service" || true
  fi
}

apply_dropins() {
  local drop src dest ovl
  install -d -m 0755 /etc/systemd/system/plugin_loader.service.d
  for drop in fast-stop.conf fex-steam-rootfs.conf sm8550.conf; do
    src=""
    [[ -f "${SYSTEM_DROPINS}/${drop}" ]] && src="${SYSTEM_DROPINS}/${drop}"
    [[ -n "$src" ]] || continue
    dest="/etc/systemd/system/plugin_loader.service.d/${drop}"
    # Paths already use /home/steamos; copy as-is (no sed).
    install -m 0644 "$src" "$dest"
    if [[ -d "$OVERLAY_ETC" ]]; then
      ovl="$OVERLAY_ETC/systemd/system/plugin_loader.service.d"
      mkdir -p "$ovl" 2>/dev/null && install -m 0644 "$src" "$ovl/${drop}" || true
    fi
    log "Installed drop-in ${drop}"
  done
}

install_bundled_plugins() {
  local sync="/usr/lib/steamos/sync-decky-bundled-plugins.sh"
  if [[ -x "$sync" ]]; then
    log "Installing bundled SM8550 plugins (LEDs + Power)"
    STEAM_USER="$REAL_USER" STEAM_HOME="$REAL_HOME" BUNDLE_ROOT="$BUNDLE_ROOT" \
      "$sync" || warn "Plugin sync failed"
    return 0
  fi
  warn "sync-decky-bundled-plugins.sh missing — skip plugins"
}

enable_cef() {
  local steam_root="${REAL_HOME}/.local/share/Steam"
  mkdir -p "$steam_root" "${REAL_HOME}/.steam"
  touch "${steam_root}/.cef-enable-remote-debugging"
  ln -sfn "$steam_root" "${REAL_HOME}/.steam/steam"
  ln -sfn "$steam_root" "${REAL_HOME}/.steam/root"
  touch "${REAL_HOME}/.steam/steam/.cef-enable-remote-debugging" 2>/dev/null || true
  chown "${REAL_UID}:${REAL_GID}" \
    "${steam_root}/.cef-enable-remote-debugging" 2>/dev/null || true
}

install_loader() {
  local branch version url emu
  branch="$(normalize_branch "${DECKY_BRANCH:-release}")"
  require_emulator
  command -v curl >/dev/null 2>&1 || die "curl is required"
  emu="$(emulator_bin || true)"
  [[ -n "$emu" ]] || die "box64/FEX binary not found"
  log "Emulator: ${emu}"

  mapfile -t meta < <(fetch_newest_loader)
  version="${meta[0]}"
  url="${meta[1]}"
  log "Installing PluginLoader ${version} (newest) — update channel $(branch_label "$branch") for ${REAL_USER}"

  mkdir -p "${HOMEBREW_ROOT}/services" "${HOMEBREW_ROOT}/settings" \
    "${HOMEBREW_ROOT}/plugins" "${HOMEBREW_ROOT}/services/.systemd"
  curl -fsSL -o "${PLUGIN_LOADER}.new" "$url" || die "Failed to download PluginLoader"
  chmod 755 "${PLUGIN_LOADER}.new"
  mv -f "${PLUGIN_LOADER}.new" "${PLUGIN_LOADER}"
  printf '%s\n' "$version" >"$LOADER_VERSION_FILE"
  if [[ "$branch" == prerelease ]]; then
    printf '{"branch": 1}\n' >"$LOADER_SETTINGS"
  else
    printf '{"branch": 0}\n' >"$LOADER_SETTINGS"
  fi

  persist_unit
  enable_cef
  apply_dropins
  install_bundled_plugins
  chown -R "${REAL_UID}:${REAL_GID}" "$HOMEBREW_ROOT"
  systemctl_root daemon-reload
  systemctl_root enable plugin_loader.service
  systemctl_root restart plugin_loader.service || systemctl_root start plugin_loader.service || true

  if [[ -x "$PLUGIN_LOADER" ]]; then
    log "PluginLoader installed at ${PLUGIN_LOADER}"
  else
    die "PluginLoader missing after install"
  fi
  if systemctl_root is-active --quiet plugin_loader.service; then
    log "plugin_loader.service is active"
  else
    warn "plugin_loader.service is not active yet — it starts on next boot via systemd"
    warn "Check: systemctl status plugin_loader.service"
  fi
  log "Fully quit Steam (Game Mode + Desktop) once so CEF remote debugging is picked up."
  log "Then open Game Mode → ⋯ (Decky). Enable SM8550-LED and SM8550-Power."
}

verify_loader() {
  log "User: ${REAL_USER}  home: ${REAL_HOME}"
  if [[ -x "$PLUGIN_LOADER" ]]; then
    log "PluginLoader: ${PLUGIN_LOADER}"
    command -v file >/dev/null 2>&1 && file "$PLUGIN_LOADER" || true
  else
    warn "PluginLoader not installed"
  fi
  [[ -f "$LOADER_VERSION_FILE" ]] && log "Version: $(tr -d '\n' <"$LOADER_VERSION_FILE")"
  persist_unit
  apply_dropins
  systemctl_root daemon-reload || true
  systemctl_root is-active plugin_loader.service || true
}

uninstall_loader() {
  systemctl_root disable --now plugin_loader.service 2>/dev/null || true
  rm -f "$PLUGIN_UNIT_ETC" "$PLUGIN_UNIT_USR" \
    /etc/systemd/system/multi-user.target.wants/plugin_loader.service
  rm -rf /etc/systemd/system/plugin_loader.service.d
  if [[ -d "$OVERLAY_ETC" ]]; then
    rm -f "$OVERLAY_ETC/systemd/system/plugin_loader.service" \
      "$OVERLAY_ETC/systemd/system/multi-user.target.wants/plugin_loader.service"
    rm -rf "$OVERLAY_ETC/systemd/system/plugin_loader.service.d"
  fi
  systemctl_root daemon-reload || true
  rm -rf "$HOMEBREW_ROOT"
  log "Decky removed"
}

ACTION="${1:-}"
case "$ACTION" in
  ""|install)
    ask_steam_client_channel
    if [[ "$DECKY_BRANCH" == "prerelease" ]]; then
      elevate_if_needed install-beta
      DECKY_BRANCH=prerelease
    else
      elevate_if_needed install-stable
      DECKY_BRANCH=release
    fi
    install_loader
    ;;
  install-stable)
    elevate_if_needed "$@"
    DECKY_BRANCH=release
    install_loader
    ;;
  install-beta)
    elevate_if_needed "$@"
    DECKY_BRANCH=prerelease
    install_loader
    ;;
  verify|status)
    elevate_if_needed "$@"
    verify_loader
    ;;
  uninstall|remove)
    elevate_if_needed "$@"
    uninstall_loader
    ;;
  -h|--help)
    cat <<EOF
Usage: install-decky [install|install-stable|install-beta|verify|uninstall]

  (no args) / install   Ask Steam Client channel, then install
  install-stable        Decky update channel = Steam Client stable
  install-beta          Decky update channel = Steam Client beta
  verify                Rewrite the systemd unit (Box64) and check the service
  uninstall             Remove Decky and ~/homebrew

PluginLoader is always the newest GitHub build, started via Box64.
Bundled plugins: SM8550-LED and SM8550-Power.
EOF
    ;;
  *)
    die "Unknown argument: $ACTION"
    ;;
esac
