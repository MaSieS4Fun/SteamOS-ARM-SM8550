#!/bin/bash
# Optional. SteamOS does not need a root password: sudo and pkexec use
# the desktop user password once pkexec is setuid root.
# Run this only if you really want a separate root account password.
set -euo pipefail
if [[ "${EUID}" -ne 0 ]]; then
  exec pkexec --disable-internal-agent "$0" "$@"
fi
echo "Set the root password (you can reuse the same password as your user)."
exec passwd root
