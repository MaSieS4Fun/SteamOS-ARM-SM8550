#!/bin/bash
# Steam talks to steamos-manager over D-Bus; this CLI is the same path.
# Always set login-mode + Plasma env before leaving Game Mode, or SDDM
# Relogin=true + Session=gamescope-wayland.desktop comes straight back.
REAL=/usr/lib/steamos/steamosctl.real
[[ -x "$REAL" ]] || REAL=/usr/bin/steamosctl.real
LOG_DIR="${HOME:-/home/steamos}/.local/state"
LOG="${LOG_DIR}/sm8550-session-switch.log"
mkdir -p "$LOG_DIR" 2>/dev/null || true

log() {
  printf '[%s] %s\n' "$(date -Iseconds 2>/dev/null || date)" "$*" >>"$LOG" 2>/dev/null || true
}

if [[ ! -x "$REAL" ]]; then
  log "ERROR: real steamosctl missing; args=$*"
  echo >&2 "sm8550 steamosctl wrapper: real binary missing"
  exit 127
fi

log "invoke uid=$(id -u) args=$* real=$REAL"

case "${1:-}" in
  switch-to-desktop-mode|switch-to-desktop-session)
    if [[ -x /usr/lib/steamos/sm8550-prepare-plasma ]]; then
      /usr/lib/steamos/sm8550-prepare-plasma
      log "prepare-plasma rc=$?"
    fi
    output="$("$REAL" set-default-desktop-session plasma.desktop 2>&1)"
    log "set-default-desktop-session rc=$? output=$output"
    ;;
esac

log "exec real args=$*"
exec "$REAL" "$@"
