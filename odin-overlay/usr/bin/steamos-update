#!/usr/bin/env bash
# Steam Gamepad UI OS-update hook. No RAUC/atomupd on this image.
#
#   --supports-duplicate-detection (alone) → 0
#   --enable-duplicate-detection is ignored; check must still exit 7 (up to date)
#   check → 7 (up to date) — also when combined with --enable-duplicate-detection
#   apply (OOBE, once) → 0 + mark OOBE + relaunch Steam in gamescope
#   apply (after login or again) → 7
set -uo pipefail

STEAM_HOME="${STEAM_HOME:-/home/steamos}"
LOG="${STEAM_HOME}/.local/share/Steam/logs/steamos-update.log"
mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
printf '%s steamos-update %s\n' "$(date -Iseconds 2>/dev/null || date)" "$*" >>"$LOG" 2>/dev/null || true
LOGINUSERS="${STEAM_HOME}/.local/share/Steam/config/loginusers.vdf"
MARKER=/var/lib/steamos-sm8550/oobe-os-update-acked
USER_MARKER="${STEAM_HOME}/.local/share/Steam/.oobe-os-update-acked"
REG_STEAM="${STEAM_HOME}/.steam/registry.vdf"
REG_LOCAL="${STEAM_HOME}/.local/share/Steam/registry.vdf"
RELAUNCH=/usr/lib/steamos/sm8550-relaunch-steam
DONE="${STEAM_HOME}/.local/share/Steam/.oobe-relaunch-done"

mark_oobe_complete() {
  python3 - "$@" <<'PY' 2>/dev/null || true
import pathlib, re, sys

WANT = (("CompletedOOBE", "1"), ("CompletedOOBEStage1", "1"))
DROP = ("ForceOOBE", "ForceOOBEStage2")

def upsert(path: pathlib.Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
    if '"Steam"' not in text:
        lines = "\n".join(f'\t\t\t\t\t"{k}"\t\t"{v}"' for k, v in WANT)
        text = (
            '"Registry"\n{\n\t"HKCU"\n\t{\n\t\t"Software"\n\t\t{\n'
            '\t\t\t"Valve"\n\t\t\t{\n\t\t\t\t"Steam"\n\t\t\t\t{\n'
            f"{lines}\n"
            "\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n"
        )
        path.write_text(text, encoding="utf-8")
        return

    for k in DROP:
        text = re.sub(r'^[ \t]*"' + re.escape(k) + r'"[ \t]*"[^"]*"[ \t]*\n', "", text, flags=re.M)

    m = re.search(
        r'("HKCU"\s*\{.*?^[ \t]*"Steam"\s*\n[ \t]*\{)',
        text,
        flags=re.M | re.S,
    )
    if not m:
        m = re.search(r'(^[ \t]*"Steam"\s*\n[ \t]*\{)', text, flags=re.M)
    if not m:
        path.write_text(text, encoding="utf-8")
        return

    head_end = m.end()
    i = head_end
    depth = 1
    while i < len(text) and depth:
        if text[i] == "{":
            depth += 1
        elif text[i] == "}":
            depth -= 1
        i += 1
    block = text[head_end : i - 1]
    indent = "\t\t\t\t\t"
    child = re.search(r'\n([ \t]+)"', "\n" + block)
    if child:
        indent = child.group(1)

    for k, v in WANT:
        pat = r'^[ \t]*"' + re.escape(k) + r'"[ \t]*"[^"]*"'
        if re.search(pat, block, flags=re.M):
            block = re.sub(pat, f'"{k}"\t\t"{v}"', block, count=1, flags=re.M)
            block = re.sub(
                r'^"' + re.escape(k) + r'"\t\t"' + re.escape(v) + r'"',
                f'{indent}"{k}"\t\t"{v}"',
                block,
                count=1,
                flags=re.M,
            )
        else:
            block = f'\n{indent}"{k}"\t\t"{v}"' + (block if block.startswith("\n") else "\n" + block)

    text = text[:head_end] + block + text[i - 1 :]
    path.write_text(text, encoding="utf-8")

for p in sys.argv[1:]:
    upsert(pathlib.Path(p))
PY
}

if [[ $# -eq 1 && "$1" == "--supports-duplicate-detection" ]]; then
  exit 0
fi

if [[ $# -eq 1 && "$1" == "--mark-oobe-only" ]]; then
  mark_oobe_complete "$REG_STEAM" "$REG_LOCAL"
  exit 0
fi

check=0
apply=0
for arg in "$@"; do
  case "$arg" in
    --supports-duplicate-detection|--enable-duplicate-detection|--disable-duplicate-detection) ;;
    check) check=1 ;;
    apply) apply=1 ;;
  esac
done

if [[ "$check" -eq 1 ]]; then
  exit 7
fi

oobe=0
if [[ ! -f "$LOGINUSERS" ]] || ! grep -qs '"AccountName"' "$LOGINUSERS"; then
  oobe=1
fi

# YieldingApplyUpdateOS on holo often runs only:
#   steamos-update --enable-duplicate-detection
# (no "apply" argv). That used to exit 0 without relaunch → OOBE spinner forever.
if [[ "$apply" -eq 0 && "$check" -eq 0 ]]; then
  enable_dd=0
  for arg in "$@"; do
    [[ "$arg" == "--enable-duplicate-detection" ]] && enable_dd=1
  done
  if [[ "$enable_dd" -eq 1 && "$oobe" -eq 1 && ! -f "$DONE" ]]; then
    apply=1
  fi
fi

if [[ "$apply" -eq 0 ]]; then
  exit 0
fi

if [[ "$oobe" -eq 0 ]]; then
  exit 7
fi

# Already forced the post-update Steam relaunch — further apply must not
# look like a failed OS update (exit 7 during apply = retry loop).
if [[ -f "$DONE" ]]; then
  exit 7
fi

mkdir -p /var/lib/steamos-sm8550 "${STEAM_HOME}/.local/share/Steam" 2>/dev/null || true
touch "$MARKER" "$USER_MARKER" 2>/dev/null || true
mark_oobe_complete "$REG_STEAM" "$REG_LOCAL"

# Apply "succeeds", then kill+relaunch Steam in the same gamescope session.
# Run relaunch immediately (no sleep, no background): user must not stay on
# the OOBE update spinner or mash buttons while a delayed job races the UI.
mark_oobe_complete "$REG_STEAM" "$REG_LOCAL"
touch "$DONE" 2>/dev/null || true
if [[ -x "$RELAUNCH" ]]; then
  STEAM_HOME="$STEAM_HOME" HOME="$STEAM_HOME" \
    DISPLAY="${DISPLAY:-:0}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}" \
    GAMESCOPE_WAYLAND_DISPLAY="${GAMESCOPE_WAYLAND_DISPLAY:-gamescope-0}" \
    DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/1000}/bus}" \
    "$RELAUNCH"
else
  helper=/usr/lib/steamos/sm8550-oobe-restart-steam
  if [[ -x "$helper" ]]; then
    STEAM_HOME="$STEAM_HOME" HOME="$STEAM_HOME" "$helper"
  else
    pkill -f 'steamrtarm64/steam' 2>/dev/null || true
  fi
fi

exit 0
